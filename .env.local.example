# From https://www.discogs.com/settings/developers
DISCOGS_CONSUMER_KEY=
DISCOGS_CONSUMER_SECRET=

# At least 32 characters. Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# No trailing slash. Used as the Discogs OAuth callback base.
# Local: http://localhost:3000
# Vercel: set this in Project → Settings → Environment Variables to your
# production URL, e.g. https://daffodilrecords.vercel.app
APP_URL=http://localhost:3000
