# From https://www.discogs.com/settings/developers
DISCOGS_CONSUMER_KEY=
DISCOGS_CONSUMER_SECRET=

# At least 32 characters. Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# No trailing slash. Used as a fallback OAuth base URL.
# Local: http://localhost:3000
# Vercel: set this to https://YOUR-APP.vercel.app
# Do NOT set APP_URL=http://localhost:3000 on Vercel — that breaks login/logout.
# Auth routes also read the request Host header, but APP_URL should still match production.
APP_URL=http://localhost:3000
